body {
  background-color: #f5f5f5;
}

.hero {
  height: 70vh;
  background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)),
              url("https://images.unsplash.com/photo-1445205170230-053b83016050") center/cover;
}

.card {
  transition: 0.3s ease;
}

.card:hover {
  transform: scale(1.05);
}

footer {
  background: #111;
  color: white;
  padding: 20px;
}
